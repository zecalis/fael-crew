#!/bin/sh
# git-ship — push pr for the current branch of any repo, in one call: `git ship` once this file is
# on PATH (ln -s <crew>/bin/git-ship ~/.local/bin/git-ship). No lead, no plan/<p>/stack. Title and
# body come from git facts, the gate from .fael/worktree.json. Never merges.
#
#   git ship [-m <title>] [--body <file>] [--dry] [--in <wt>]
#       clean    refuse (4) a dirty tree, main, or no commit on origin/main..HEAD (after a fetch)
#       pr-state refuse (3) when the branch's PR is merged: cut a new branch from origin/main
#                carrying only the unmerged commits
#       rebase   git rebase origin/main. A conflict is settled per stopped commit from .fael/worktree.json
#                {"gate": "<cmd>", "ship": {"regen": {"<path>": "<cmd>"}, "fresh": ["<glob>"]}}:
#                a "fresh" path (needs regenerating by the agent) aborts the rebase; a "regen" path
#                takes main's version, runs its command, is added; any other path is added only when
#                rerere resolved every one of them, else abort. Abort = exit 6, one line per file
#       gate     "gate" from the same file (<wt>'s, else the main checkout's), its output in a log
#       push     git push --force-with-lease --force-if-includes -u origin HEAD
#       pr       gh pr create (or edit the open one); then fael chunk done for each Fael-Chunk
#                trailer when fael is installed (done chunks skipped, a rerun is safe)
#       title: -m, else the lone commit's subject (several commits and no -m: prints their subjects
#       and the shortstat, exit 4); body: --body as given, else the commits' subjects and bodies
#       (trailers out) + the diffstat + "Removed (from the diff)"; the Claude Code line is added
#       when missing. --dry prints title, body and gate, rebases and pushes nothing.
#       One line per step, "✓ <step>" or "✗ <step>"; the failing step alone prints more. The last
#       line on success: PR <n> <url>
#
# Exit: 0 shipped · 1 push failed · 2 gate failed (nothing pushed) · 3 PR merged · 4 refused
# (usage, dirty, main, no commits, no title, no gate) · 5 gh failed after the push (rerun) ·
# 6 rebase conflict that needs the agent (aborted, branch as it was)
set -eu

die() { c=$1; s=$2; shift 2; echo "✗ $s: $*" >&2; exit "$c"; }

wt= title= body= dry=
while [ $# -gt 0 ]; do
  case $1 in
    --dry) dry=1; shift; continue ;;
    --in | -m | --body) [ $# -ge 2 ] || die 4 usage "$1 needs a value" ;;
    *) die 4 usage "unknown option: $1 (see the head of $0)" ;;
  esac
  case $1 in --in) wt=$2 ;; -m) title=$2 ;; --body) body=$2 ;; esac
  shift 2
done
[ -z "$body" ] || [ -f "$body" ] || die 4 usage "no body file: $body"
case $body in '' | /*) ;; *) body=$PWD/$body ;; esac
if [ -n "$wt" ]; then
  wt=$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null) || die 4 usage "$wt is not a git worktree"
  cd "$wt"
fi
top=$(git rev-parse --show-toplevel 2>/dev/null) || die 4 usage "not a git repository"
logs=$(git rev-parse --path-format=absolute --git-common-dir)/git-ship
mkdir -p "$logs"

br=$(git symbolic-ref -q --short HEAD) || die 4 clean "detached HEAD: switch to the branch"
[ "$br" != main ] || die 4 clean "on main: cut a branch first"
[ -z "$(git status --porcelain)" ] || die 4 clean "uncommitted work"
git fetch -q origin || die 4 clean "git fetch origin failed"
git rev-parse -q --verify refs/remotes/origin/main >/dev/null || die 4 clean "no origin/main"
range=origin/main..HEAD
count=$(git rev-list --count "$range")
[ "$count" -gt 0 ] || die 4 clean "no commits on $range"
echo "✓ clean"

# the open PR wins (a reused branch name); a merged one means the branch is spent
prs=$(gh pr list --head "$br" --state all --json number,state -q '.[] | "\(.state) \(.number)"') ||
  die 4 pr-state "gh pr list failed"
n=$(printf '%s\n' "$prs" | awk '$1 == "OPEN" {print $2; exit}')
if [ -z "$n" ] && printf '%s\n' "$prs" | grep -q '^MERGED '; then
  die 3 pr-state "$br is merged: cut a new branch from origin/main carrying only the unmerged commits"
fi
echo "✓ pr-state"

if [ -z "$title" ]; then
  if [ "$count" = 1 ]; then title=$(git log -1 --format=%s)
  else
    git log --format=%s "$range"
    git diff --shortstat origin/main...HEAD
    die 4 title "$count commits: rerun with -m '<type(scope): summary>'"
  fi
fi

# the wt's config, else the main checkout's; read again after the rebase, which may change it
readcfg() {
  f=$top/.fael/worktree.json
  [ -f "$f" ] || f=$(git worktree list --porcelain | sed -n '1s/^worktree //p')/.fael/worktree.json
  gate=$(jq -r '.gate // empty' "$f" 2>/dev/null) || gate=
  [ -n "$gate" ] || die 4 gate "no gate in $f: add {\"gate\": \"<cmd>\"}"
}
readcfg

# bail: abort the rebase, list the conflicted files of this stop ($logs/u), exit 6
bail() {
  git rebase --abort
  while IFS= read -r p; do echo "✗ rebase: conflict in $p"; done <"$logs/u"
  [ -s "$logs/u" ] || echo "✗ rebase: stopped without a conflict: $(tail -3 "$logs/rebase.log")"
  [ -z "${1:-}" ] || echo "✗ rebase: $1"
  echo "rerun after resolving: git rebase origin/main"
  exit 6
}
isfresh() { # path in .ship.fresh (glob)
  jq -r '.ship.fresh // [] | .[]' "$f" >"$logs/fresh"
  while IFS= read -r g; do
    # shellcheck disable=SC2254 # the glob is the point
    case $1 in $g) return 0 ;; esac
  done <"$logs/fresh"
  return 1
}
rebase() {
  git merge-base --is-ancestor origin/main HEAD && return 0
  rc=0; git rebase origin/main >"$logs/rebase.log" 2>&1 || rc=$?
  while [ "$rc" != 0 ]; do
    if [ ! -d "$(git rev-parse --git-path rebase-merge)" ]; then
      echo "✗ rebase (log: $logs/rebase.log)"; tail -40 "$logs/rebase.log"; exit 6
    fi
    git -c core.quotePath=false diff --name-only --diff-filter=U >"$logs/u"
    [ -s "$logs/u" ] || bail
    : >"$logs/others"
    # fresh first: it aborts before anything is touched
    while IFS= read -r p; do ! isfresh "$p" || bail; done <"$logs/u"
    while IFS= read -r p; do
      cmd=$(jq -r --arg p "$p" '.ship.regen[$p] // empty' "$f" 2>/dev/null) || cmd=
      # --ours is the upstream side while rebasing: main's version, not the commit's
      if [ -n "$cmd" ] && git restore --ours -- "$p" 2>/dev/null; then
        sh -c "$cmd" >>"$logs/rebase.log" 2>&1 || bail "$cmd failed (log: $logs/rebase.log)"
        git add -- "$p"
      else echo "$p" >>"$logs/others"; fi
    done <"$logs/u"
    if [ -s "$logs/others" ]; then
      # rerere writes its resolution into the files but does not stage them
      [ "$(git config --type=bool rerere.enabled || :)" = true ] && [ -z "$(git rerere remaining)" ] || bail
      while IFS= read -r p; do git add -- "$p"; done <"$logs/others"
    fi
    rc=0; GIT_EDITOR=true git rebase --continue >>"$logs/rebase.log" 2>&1 || rc=$?
  done
}
[ -n "$dry" ] || { rebase; echo "✓ rebase"; readcfg; count=$(git rev-list --count "$range"); }

b=$logs/pr-$(echo "$br" | tr / -).md
if [ -n "$body" ]; then cat "$body" >"$b"
else
  git log --format='%(trailers:only,unfold)' "$range" | grep . >"$logs/trailers" || : # grep -f: no blank pattern
  { git log --reverse --format='- %s%n%n%b' "$range" | grep -vxFf "$logs/trailers" | cat -s
    printf '\n%s\n' "$(git diff --stat origin/main...HEAD | tail -1)"
    # the mechanical half of Removed / Breaking; renames of a CLI, schema or URL key stay the body's
    lost=$(git diff --name-only --diff-filter=D origin/main...HEAD | sed 's/^/- deleted: /'
      git diff --numstat --diff-filter=M origin/main...HEAD | awk '$2 >= 50 {print "- lost " $2 " lines: " $3}')
    printf '\n## Removed (from the diff)\n\n%s\n' "${lost:-none}"; } >"$b"
fi
grep -qF '🤖 Generated with [Claude Code](https://claude.com/claude-code)' "$b" ||
  printf '\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n' >>"$b"

if [ -n "$dry" ]; then
  printf 'title: %s\n\n' "$title"; cat "$b"
  echo "gate: $gate"
  exit 0
fi

rc=0; sh -c "$gate" >"$logs/gate.log" 2>&1 || rc=$?
if [ "$rc" != 0 ]; then
  echo "✗ gate (log: $logs/gate.log)"; tail -40 "$logs/gate.log"; exit 2
fi
echo "✓ gate"

# the flags are written out: push.useForceIfIncludes may not be set on this machine
rc=0; git push -q --force-with-lease --force-if-includes -u origin HEAD >"$logs/push.log" 2>&1 || rc=$?
if [ "$rc" != 0 ]; then
  echo "✗ push (log: $logs/push.log)"; tail -40 "$logs/push.log"
  echo "remote has commits you lack: fetch and look"
  exit 1
fi
echo "✓ push"

if [ -n "$n" ]; then
  gh pr edit "$n" --title "$title" --body-file "$b" >/dev/null || die 5 pr "gh pr edit $n failed; $br is pushed, rerun"
  u=$(gh pr view "$n" --json url -q .url) || u=
else
  u=$(gh pr create --head "$br" --base main --title "$title" --body-file "$b") ||
    die 5 pr "gh pr create failed; $br is pushed, rerun"
  n=${u##*/}
fi
case $n in '' | *[!0-9]*) die 5 pr "gh gave no PR number: $u" ;; esac
echo "✓ pr"
echo "PR $n $u"

# fael chunk done for each Fael-Chunk trailer (done in crew-run: its hand-off, a pair's halves)
command -v fael >/dev/null 2>&1 || exit 0
fin='[.notes[] | select(startswith("finished:"))] | last // empty | ltrimstr("finished: ")'
for t in $(git log --reverse --format='%(trailers:key=Fael-Chunk,valueonly,separator=)|%(trailers:key=Fael-Run,valueonly,separator=)' "$range"); do
  u=${t%%|*} r=${t#*|}
  [ -n "$u" ] || continue
  lane=$(fael chunk show "$u" --json | jq -r "$fin")
  for c in $u $(fael chunk show "$u" --json | jq -r '.pair[]'); do
    j=$(fael chunk show "$c" --json)
    [ "$(printf '%s\n' "$j" | jq -r .state)" != done ] || continue
    h=$(printf '%s\n' "$j" | jq -r "$fin")
    fael chunk done "$c" "${h:-${lane:-landed in PR $n}}" --pr "$n" ${r:+--run "$r"} >/dev/null
  done
done
