#!/bin/sh
# crew-run — the lead's processes: one headless claude -p (an opencode lane: opencode run) per call, in a free worktree, seen on
# the board while it runs, its fael run ended once it exits. No state of its own: the session
# and run ids live in fael, the PID is the lead's background task, logs under
# <git-common-dir>/crew-run/ die with the wave. Run it from any cwd. It blocks until claude
# exits, often past a 10-minute foreground call, so the lead backgrounds it: the exit wakes it.
#
#   crew-run work   <p> <n> <uid> --in <wt> [--model m] [--contract <id>]…
#       plan/<p>/lane/<uid> in <wt> (new from s<n>, or the lane as it is on a resume), fael chunk
#       start under a fresh session id with the run's model and client (--model, else the
#       approval's, else the chunk's hint; the approval's client, else claude), the brief + each
#       contract + the lead's rules into claude -p (or opencode run, for an opencode approval),
#       fael run beat while it runs, fael run end with its cost (its outside lines) once it
#       exits, then <wt> detached so the lane can go once it lands
#   crew-run review <p> <n> --in <wt> --lanes <uid,…>
#       /fael-review high --fix of s<n> against the stack (origin/main for set 1), in <wt>
#       detached at s<n>; opus when a lane ran on opus, else sonnet; its fixes stay on <wt>'s HEAD,
#       their paths outside the lanes' scopes said as work says them
#   crew-run scope  <p> <uid>…
#       G2's check: each path a chunk's brief names that its scope (its pair's too) and
#       project.shared lack, as "unscoped <label>: <path>", or "unscoped: none"
#   crew-run done   <p> --pr <N> [--in <wt>]
#       after crew-git ship: fael chunk done --pr N --run R for each Fael-Chunk/Fael-Run trailer
#       on origin/main..plan/<p>/stack (crew-git land wrote them) and its pair, the hand-off the
#       lane's finished: note and its "kept <path>: <why>" notes; chunks already done are skipped,
#       so a rerun is safe
#
# Exit, its own table (crew-git's 1 and 2 mean other things): 0 finished · 1 waited on the
# owner · 2 crashed (claude failed, no new "finished:" note, or a reviewer left uncommitted
# work) · 4 refused (usage, fael < 0.58.0, missing ref, dirty or main worktree, fael refused the start, stack not
# pushed); done stops at the first fael refusal with its exit
set -eu

die() { c=$1; shift; echo "crew-run: $*" >&2; exit "$c"; }

# 0.58.0: run end prints the lane's outside lines, the lead's scope check (G5)
fael --version | awk '{split($2, v, "."); exit !(v[1] > 0 || v[2] >= 58)}' ||
  die 4 "needs fael >= 0.58.0, have $(fael --version)"

# the board calls a run stalled after 30 min unseen (fael board.rs); beat well inside that
beat=${CREW_RUN_BEAT:-300}

verb=${1:-}; p=${2:-}
[ $# -ge 2 ] || die 4 "usage: see the head of $0"
shift 2
case $p in '' | *[!A-Za-z0-9._-]*) die 4 "bad project: $p" ;; esac
n= uid=
case $verb in
  work) [ $# -ge 2 ] || die 4 "work <p> <n> <uid> …"; n=$1 uid=$2; shift 2 ;;
  review) [ $# -ge 1 ] || die 4 "review <p> <n> …"; n=$1; shift ;;
  done) ;;
  scope) [ $# -ge 1 ] || die 4 "scope <p> <uid>…"; uids=$*; set -- ;;
  *) die 4 "unknown verb: $verb" ;;
esac
case $n in *[!0-9]*) die 4 "bad set number: $n" ;; esac
case $uid in *[!A-Za-z0-9]*) die 4 "bad uid: $uid" ;; esac
wt= model= contracts= lanes= pr=
while [ $# -gt 0 ]; do
  [ $# -ge 2 ] || die 4 "$1 needs a value"
  case $1 in
    --in) wt=$2 ;; --model) model=$2 ;; --contract) contracts="$contracts $2" ;; --lanes) lanes=$2 ;;
    --pr) pr=$2 ;; *) die 4 "unknown option: $1" ;;
  esac
  shift 2
done
case $verb in done | scope) ;; *) [ -n "$wt" ] || die 4 "needs --in <worktree>" ;; esac
[ "$verb" != review ] || [ -n "$lanes" ] || die 4 "review needs --lanes <uid,…>"
[ "$verb" != done ] || case $pr in '' | *[!0-9]*) die 4 "done needs --pr <N>" ;; esac

if [ -n "$wt" ]; then
  wt=$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null) || die 4 "$wt is not a git worktree"
  # the main worktree is the owner's checkout: never a lane's, whatever its state
  [ "$wt" != "$(git -C "$wt" worktree list --porcelain | sed -n '1s/^worktree //p')" ] ||
    die 4 "$wt is the main worktree, the owner's checkout; pick a lane worktree (G4.2)"
  cd "$wt"
fi
logs=$(git rev-parse --path-format=absolute --git-common-dir)/crew-run
mkdir -p "$logs"
if [ "$verb" = work ] || [ "$verb" = review ]; then
  [ -z "$(git status --porcelain)" ] || die 4 "$wt has uncommitted work"
  set=plan/$p/s$n
  git rev-parse -q --verify "refs/heads/$set" >/dev/null || die 4 "no $set: cut it first (crew-git cut)"
fi

# claude <model> <sid> <prompt file> <json out>: headless, denied what destroys work no diff
# shows (decision lead:worker-perms); the lead pushes and merges
claude_p() {
  claude -p --session-id "$2" ${1:+--model "$1"} --permission-mode auto --output-format json \
    --disallowedTools "Bash(git reset --hard *)" "Bash(git checkout -- *)" "Bash(git restore *)" \
    "Bash(git clean *)" "Bash(git stash *)" "Bash(git branch -D *)" "Bash(git push *)" \
    "Bash(git worktree remove *)" "Bash(gh pr merge *)" "Bash(printenv *)" \
    "Read(./.env*)" "Edit(./.env*)" <"$3" >"$4"
}
# opencode <model> <prompt file> <json out>: the same deny list, written as claude_p's json
# (total_cost_usd, is_error, result) so the rest reads one shape. --standalone, else a
# background service runs the worker without this env (FAEL_STATE_DIR) or the inline config;
# stdin closed, else it waits on it; the cost from the session export, as a step's can read 0.
opencode_p() {
  rc=0
  OPENCODE_CONFIG_CONTENT='{"permission":{"bash":{"git reset --hard *":"deny","git checkout -- *":"deny",
"git restore *":"deny","git clean *":"deny","git stash *":"deny","git branch -D *":"deny","git push *":"deny",
"git worktree remove *":"deny","gh pr merge *":"deny","printenv *":"deny"},
"read":{".env*":"deny"},"edit":{".env*":"deny"}}}' \
    opencode run --standalone --auto --format json ${1:+-m "$1"} "$(cat "$2")" </dev/null >"$3.jsonl" || rc=$?
  os=$(jq -r '.sessionID // empty' "$3.jsonl" 2>/dev/null | head -1)
  oc=$([ -z "$os" ] || opencode session export "$os" </dev/null 2>/dev/null | jq '.info.cost // empty' || :)
  jq -s --argjson c "${oc:-null}" '{total_cost_usd: $c, is_error: any(.[]; .type == "error"),
    result: ([.[] | select(.type == "text") | .part.text] | last // ""), session: (.[0].sessionID // null)}' \
    "$3.jsonl" >"$3" 2>/dev/null || echo '{"is_error":true}' >"$3"
  return $rc
}
cost() { jq -r '.total_cost_usd // empty' "$1" 2>/dev/null || :; }
usd() { [ -n "$1" ] && printf '$%.2f' "$1" || echo '$?'; }
failed() { [ "$1" != 0 ] || jq -e '.is_error == true' "$2" >/dev/null 2>&1; }
sid=$(uuidgen | tr A-Z a-z)
# under <path> <scope paths>: fael's prefix rule, a path equal to or below one of them
under() { for d in $2; do case $1 in "$d" | "${d%/}"/*) return 0 ;; esac; done; return 1; }

case $verb in
work)
  lane=plan/$p/lane/$uid
  if git rev-parse -q --verify "refs/heads/$lane" >/dev/null; then
    git switch -q "$lane" || die 4 "cannot switch $wt to $lane (checked out elsewhere?)"
  else
    git switch -q -c "$lane" "$set" || die 4 "cannot create $lane in $wt"
  fi
  # notes carry no time: a note is this run's when it comes after the ones already there
  before=$(fael chunk show "$uid" --json | jq '.notes | length')
  brief=$logs/$uid.md
  # fael's run row keeps the model and client only when start is told them
  j=$(fael chunk show "$uid" --json)
  model=${model:-$(printf '%s\n' "$j" | jq -r '.approval.model // .model_hint // empty')}
  client=$(printf '%s\n' "$j" | jq -r '.approval.client // "claude"')
  CLAUDE_CODE_SESSION_ID=$sid fael chunk start "$uid" ${model:+--model "$model"} --client "$client" >"$brief" || {
    git switch -q --detach; die 4 "fael refused the start of $uid: a wrong cut, back to G2"; }
  R=$(head -1 "$brief" | awk '{print $3}')
  for c in $contracts; do fael find "$c" --full; done >>"$brief"
  cat >>"$brief" <<EOF

Lead's rules: do not run fael chunk done or the check before it, do not push. Each step that
passes: a WIP commit + fael chunk note $uid "<done; next>". Finished: a last note
"finished: <what works, what the owner checks>" (no branch: the lane lands squashed) and exit. A question, a wrong contract, a
needed env or secret: fael chunk wait $uid "<question>" --on owner and exit.
EOF
  echo "lane $uid · R $R · $client ${model:-default} · session $sid · $wt"
  # ponytail: a killed loop's sleep lingers up to one beat, silent; kill the group if it matters
  (while sleep "$beat"; do fael run beat "$R" || :; done) >/dev/null 2>&1 &
  bp=$!
  trap 'kill $bp 2>/dev/null || :' EXIT
  out=$logs/$uid-$R.json
  rc=0
  case $client in
    opencode) opencode_p "$model" "$brief" "$out" || rc=$? ;;
    *) claude_p "$model" "$sid" "$brief" "$out" || rc=$? ;;
  esac
  kill $bp 2>/dev/null || :
  wait $bp 2>/dev/null || :
  c=$(cost "$out")
  ends=$(fael run end "$R" ${c:+--cost "$c"})
  printf '%s\n' "$ends"
  # fael prints outside lines only when a path left the scope: say the clean case too
  case $ends in *"outside, "*) ;; *) echo "outside: none" ;; esac
  git switch -q --detach
  # ponytail: a pair's wait or note may sit on its other uid; read both if pairs crash here
  j=$(fael chunk show "$uid" --json)
  q=$(printf '%s\n' "$j" | jq -r '.wait.text // empty')
  last=$(printf '%s\n' "$j" | jq -r --argjson b "$before" '.notes[$b:] | last // empty')
  if [ -n "$q" ]; then state=waited x=1
  elif ! failed "$rc" "$out" && [ "${last#finished:}" != "$last" ]; then state=finished x=0
  else state=crashed x=2; fi
  echo "lane $uid · R $R · $state · $(usd "$c") · $(git rev-list --count "$set..$lane") commits"
  [ -z "$q" ] || echo "wait: $q"
  [ -z "$last" ] || echo "last note: $last"
  [ "$rc" = 0 ] || echo "$client exit $rc · log: $out"
  d=$(git status --porcelain | wc -l | tr -d ' ')
  [ "$d" = 0 ] || echo "uncommitted: $d files left in $wt"
  exit $x
  ;;
review)
  base=plan/$p/stack
  git rev-parse -q --verify "refs/heads/$base" >/dev/null || base=origin/main
  # the reviewer takes the set's strongest lane: opus when one ran on opus (the owner's
  # approval already priced its risk), else sonnet — never haiku
  model=sonnet
  for u in $(echo "$lanes" | tr , ' '); do
    m=$(fael chunk show "$u" --json | jq -r '.run.model // .approval.model // .model_hint // ""') ||
      die 4 "no chunk $u"
    case $m in *opus*) model=opus ;; esac
  done
  git switch -q --detach "$set"
  S0=$(git rev-parse HEAD)
  prompt=$logs/review-s$n.md
  echo "/fael-review high --fix $base...$set — spec per lane: fael chunk show <uid> ($lanes); a done criterion the diff leaves undone is a major. Commit each fix you make on this detached HEAD, never on a branch; run only the tests of files you touch, G7 stack gates the set; record each finding you leave with fael add." >"$prompt"
  echo "review $set · $model · session $sid · $wt"
  out=$logs/review-s$n-$sid.json
  rc=0; claude_p "$model" "$sid" "$prompt" "$out" || rc=$?
  c=$(cost "$out")
  # a reviewer that switched onto s<n> moved it: count from where it started, and detach
  git switch -q --detach 2>/dev/null || :
  echo "review $set · $(usd "$c") · $(git rev-list --count "$S0..HEAD") fix commits · HEAD $(git rev-parse --short HEAD)"
  # the fixes' scope check, in run end's words (fael's prefix rule): a path no lane of the set
  # (nor its pair) holds, project.shared aside, unowned or in another unfinished chunk
  decl=$(for u in $(echo "$lanes" | tr , ' '); do fael chunk show "$u" --json | jq -r '.uid, .pair[]'; done | tr '\n' ' ')
  scope=$(for u in $decl; do fael chunk show "$u" --json | jq -r '.scope[]'; done; cat .fael/shared 2>/dev/null || :)
  # ponytail: a chunk show per chunk whose scope covers the path; fine at a plan's size
  owner() {
    fael plan export --json | jq -r '.plan as $p | .chunks[] | "\(.uid) \($p)/\(.label // .uid) \(.scope | join(" "))"' |
      while read -r u l s; do
        case " $decl " in *" $u "*) continue ;; esac
        under "$1" "$s" || continue
        case $(fael chunk show "$u" --json | jq -r .state) in done | replaced | dropped) continue ;; esac
        echo "$l"; break
      done
  }
  o=
  for f in $(git diff --name-only "$S0" HEAD); do
    under "$f" "$scope" && continue
    w=$(owner "$f")
    w=${w:+in $w}
    o="${o}outside, ${w:-unowned}: $f
"
  done
  printf '%s' "${o:-outside: none
}"
  jq -r '.result // empty' "$out" 2>/dev/null || :
  failed "$rc" "$out" && { echo "claude exit $rc · log: $out"; exit 2; }
  d=$(git status --porcelain | wc -l | tr -d ' ')
  [ "$d" = 0 ] || { echo "uncommitted: $d files the reviewer left in $wt"; exit 2; }
  ;;
scope)
  # a path the brief names is one fael's overlaps never see unless the scope lists it
  # ponytail: a path-shaped word (e.g. a gates file the brief only reads) lists too
  sh=$(cat "$(git rev-parse --show-toplevel)/.fael/shared" 2>/dev/null || :)
  o=
  for u in $uids; do
    case $u in *[!A-Za-z0-9._-]*) die 4 "bad uid: $u" ;; esac
    j=$(fael chunk show "$u" --json) || die 4 "no chunk $u"
    # a jq that fails here stops the check: it must never read as a clean "none"
    b=$(printf '%s\n' "$j" | jq -r '.brief // empty') || die 4 "cannot read the brief of $u"
    sc=$(for c in $u $(printf '%s\n' "$j" | jq -r '.pair[]'); do fael chunk show "$c" --json | jq -r '.scope[]'; done)
    for f in $(printf '%s\n' "$b" | grep -oE '[A-Za-z_.][A-Za-z0-9_.-]*(/[A-Za-z0-9_.-]+)*\.[A-Za-z][A-Za-z0-9]*' | sort -u); do
      under "$f" "$sc $sh" || o="${o}unscoped $(printf '%s\n' "$j" | jq -r '.label // .uid'): $f
"
    done
  done
  printf '%s' "${o:-unscoped: none
}"
  ;;
done)
  st=plan/$p/stack
  K=$(git rev-parse -q --verify "refs/heads/$st") || die 4 "no $st"
  [ "$(git rev-parse -q --verify "refs/remotes/origin/$st")" = "$K" ] ||
    die 4 "origin does not hold $st at its tip: crew-git ship first"
  for t in $(git log --reverse --format='%(trailers:key=Fael-Chunk,valueonly,separator=)|%(trailers:key=Fael-Run,valueonly,separator=)|%h' "origin/main..$K"); do
    u=${t%%|*} r=${t#*|} k=${t##*|}
    r=${r%%|*}
    [ -n "$u" ] || continue # a review fix: no chunk of its own
    fin='[.notes[] | select(startswith("finished:"))] | last // empty | ltrimstr("finished: ")'
    lane=$(fael chunk show "$u" --json | jq -r "$fin")
    # an unowned path the lead kept (G5) rides in the hand-off: kept <path>: <why>
    kept=$(fael chunk show "$u" --json | jq -r '[.notes[] | select(startswith("kept "))] | join(" · ")')
    # a pair is one lane, one run: each half is done on its own, its hand-off the lane's when it
    # wrote none
    for c in $u $(fael chunk show "$u" --json | jq -r '.pair[]'); do
      j=$(fael chunk show "$c" --json)
      [ "$(printf '%s\n' "$j" | jq -r .state)" != done ] || { echo "$c already done"; continue; }
      h=$(printf '%s\n' "$j" | jq -r "$fin")
      # the lane branch went at land: a note naming it points at its squash in the PR instead
      h=$(printf '%s\n' "${h:-${lane:-landed in $st}}${kept:+ · $kept}" | sed "s#plan/$p/lane/$u#$k (PR $pr)#g")
      fael chunk done "$c" "$h" --pr "$pr" ${r:+--run "$r"}
    done
  done
  ;;
esac
