#!/bin/sh
# crew-pr — push pr for the current branch of any repo, in one call: no lead, no plan/<p>/stack.
# Title and body come from git facts, the gates from .fael/worktree.json. Never merges.
#
#   crew-pr [-m <title>] [--body <file>] [--dry] [--in <wt>]
#       refuse (4) a dirty tree, main, or no commit on origin/main..HEAD; refuse (3) when the
#       branch's PR is merged (cut a new branch from origin/main with the unmerged commits);
#       title: -m, else the lone commit's subject (several commits and no -m: prints their subjects
#       and the shortstat, exit 4); body: --body as given, else the commits' subjects and bodies
#       (trailers out) + the diffstat + "Removed (from the diff)"; the Claude Code line is added
#       when missing; "gate" then "e2e" from .fael/worktree.json (<wt>'s, else the main
#       checkout's) run, one line each; --dry prints title, body and gates and stops; then push,
#       gh pr create (or edit the open PR), "PR <n> <url>", and fael chunk done for each
#       Fael-Chunk trailer on the commits (chunks already done are skipped, a rerun is safe)
#
# Exit: 0 shipped · 1 push failed · 2 a gate failed (nothing pushed) · 3 PR already merged ·
# 4 refused (usage, dirty, main, no commits, no title, no gate) · 5 gh failed after the push (rerun)
set -eu

die() { c=$1; shift; echo "crew-pr: $*" >&2; exit "$c"; }

wt= title= body= dry=
while [ $# -gt 0 ]; do
  case $1 in
    --dry) dry=1; shift; continue ;;
    --in | -m | --body) [ $# -ge 2 ] || die 4 "$1 needs a value" ;;
    *) die 4 "unknown option: $1 (usage: see the head of $0)" ;;
  esac
  case $1 in --in) wt=$2 ;; -m) title=$2 ;; --body) body=$2 ;; esac
  shift 2
done
[ -z "$body" ] || [ -f "$body" ] || die 4 "no body file: $body"
case $body in '' | /*) ;; *) body=$PWD/$body ;; esac
if [ -n "$wt" ]; then
  wt=$(git -C "$wt" rev-parse --show-toplevel 2>/dev/null) || die 4 "$wt is not a git worktree"
  cd "$wt"
fi
top=$(git rev-parse --show-toplevel 2>/dev/null) || die 4 "not a git repository"
br=$(git symbolic-ref -q --short HEAD) || die 4 "detached HEAD: switch to the branch"
[ "$br" != main ] || die 4 "on main: cut a branch first"
[ -z "$(git status --porcelain)" ] || die 4 "uncommitted work"
git fetch -q origin || die 4 "git fetch origin failed"
git rev-parse -q --verify refs/remotes/origin/main >/dev/null || die 4 "no origin/main"
range=origin/main..HEAD
count=$(git rev-list --count "$range")
[ "$count" -gt 0 ] || die 4 "no commits on $range"

# the open PR wins (a reused branch name); a merged one means the branch is spent
prs=$(gh pr list --head "$br" --state all --json number,state -q '.[] | "\(.state) \(.number)"') ||
  die 4 "gh pr list failed"
n=$(printf '%s\n' "$prs" | awk '$1 == "OPEN" {print $2; exit}')
if [ -z "$n" ] && printf '%s\n' "$prs" | grep -q '^MERGED '; then
  die 3 "$br is merged: cut a new branch from origin/main carrying only the unmerged commits"
fi

if [ -z "$title" ]; then
  if [ "$count" = 1 ]; then title=$(git log -1 --format=%s)
  else
    git log --format=%s "$range"
    git diff --shortstat origin/main...HEAD
    die 4 "$count commits: rerun with -m '<type(scope): summary>'"
  fi
fi

f=$top/.fael/worktree.json
[ -f "$f" ] || f=$(git worktree list --porcelain | sed -n '1s/^worktree //p')/.fael/worktree.json
gate=$(jq -r '.gate // empty' "$f" 2>/dev/null) || gate=
e2e=$(jq -r '.e2e // empty' "$f" 2>/dev/null) || e2e=
[ -n "$gate$e2e" ] || die 4 "no gate in $f: add {\"gate\": \"<cmd>\", \"e2e\": \"<cmd>\"}"

logs=$(git rev-parse --path-format=absolute --git-common-dir)/crew-pr
mkdir -p "$logs"
b=$logs/pr-$(echo "$br" | tr / -).md
if [ -n "$body" ]; then cat "$body" >"$b"
else
  git log --format='%(trailers:only,unfold)' "$range" | grep . >"$logs/trailers" || : # grep -f: no blank pattern
  { git log --reverse --format='- %s%n%n%b' "$range" | grep -vxFf "$logs/trailers" | cat -s
    printf '\n%s\n' "$(git diff --stat origin/main...HEAD | tail -1)"
    # the mechanical half of Removed / Breaking; renames of a CLI, schema or URL key stay the body's
    lost=$(git diff --name-only --diff-filter=D origin/main...HEAD | sed 's/^/- deleted: /'
      git diff --numstat --diff-filter=M origin/main...HEAD | awk '$2 >= 50 {print "- lost " $2 " lines: " $3}')
    printf '\n## Removed (from the diff)\n\n%s\n' "${lost:-none}"; } >"$b"
fi
grep -qF '🤖 Generated with [Claude Code](https://claude.com/claude-code)' "$b" ||
  printf '\n🤖 Generated with [Claude Code](https://claude.com/claude-code)\n' >>"$b"

if [ -n "$dry" ]; then
  printf 'title: %s\n\n' "$title"; cat "$b"
  [ -z "$gate" ] || echo "gate: $gate"
  [ -z "$e2e" ] || echo "e2e: $e2e"
  exit 0
fi

for g in gate e2e; do
  eval "cmd=\${$g}"
  [ -n "$cmd" ] || continue
  rc=0; sh -c "$cmd" >"$logs/$g.log" 2>&1 || rc=$?
  if [ "$rc" != 0 ]; then
    echo "$g FAIL (log: $logs/$g.log)"; tail -40 "$logs/$g.log"; exit 2
  fi
  echo "$g ok"
done

git push -q -u origin HEAD || die 1 "git push failed"
if [ -n "$n" ]; then
  gh pr edit "$n" --title "$title" --body-file "$b" >/dev/null || die 5 "gh pr edit $n failed; $br is pushed, rerun"
  u=$(gh pr view "$n" --json url -q .url) || u=
else
  u=$(gh pr create --head "$br" --base main --title "$title" --body-file "$b") ||
    die 5 "gh pr create failed; $br is pushed, rerun"
  n=${u##*/}
fi
case $n in '' | *[!0-9]*) die 5 "gh gave no PR number: $u" ;; esac
echo "PR $n $u"

# fael chunk done for each Fael-Chunk trailer (done in crew-run: its hand-off, a pair's halves)
fin='[.notes[] | select(startswith("finished:"))] | last // empty | ltrimstr("finished: ")'
for t in $(git log --reverse --format='%(trailers:key=Fael-Chunk,valueonly,separator=)|%(trailers:key=Fael-Run,valueonly,separator=)' "$range"); do
  u=${t%%|*} r=${t#*|}
  [ -n "$u" ] || continue
  lane=$(fael chunk show "$u" --json | jq -r "$fin")
  for c in $u $(fael chunk show "$u" --json | jq -r '.pair[]'); do
    j=$(fael chunk show "$c" --json)
    [ "$(printf '%s\n' "$j" | jq -r .state)" != done ] || continue
    h=$(printf '%s\n' "$j" | jq -r "$fin")
    fael chunk done "$c" "${h:-${lane:-landed in PR $n}}" --pr "$n" ${r:+--run "$r"} >/dev/null
  done
done
